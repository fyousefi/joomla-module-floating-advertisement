<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="3.0" client="site" method="upgrade">
	<name>MOD_FLOATING_ADVERTISING</name>
	<author>F.Yousefi</author>
	<authorEmail>asiasunnet@gmail.com</authorEmail>
	<authorUrl>https://www.asiasun.ir</authorUrl>
	<creationDate>2026-09-12</creationDate>
	<copyright>(C) 2026 AsiaSun.ir, Pvt. Ltd. All rights reserved</copyright>
	<license>GNU/GPL http://www.gnu.org/copyleft/gpl.html</license>
	<version>2.0.0</version>
	<description>MOD_FLOATING_ADVERTISING_XML_DESCRIPTION</description>

	<files>
		<filename module="mod_floating_advertising">mod_floating_advertising.php</filename>
		<filename>helper.php</filename>
		<filename>index.html</filename>
		<filename>CHANGELOG.md</filename>
		<filename>README.md</filename>
		<filename>LICENSE</filename>
		<folder>tmpl</folder>
		<folder>language</folder>
	</files>

	<languages>
		<language tag="en-GB">language/en-GB/en-GB.mod_floating_advertising.ini</language>
		<language tag="en-GB">language/en-GB/en-GB.mod_floating_advertising.sys.ini</language>
		<language tag="fa-IR">language/fa-IR/fa-IR.mod_floating_advertising.ini</language>
		<language tag="fa-IR">language/fa-IR/fa-IR.mod_floating_advertising.sys.ini</language>
	</languages>

	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="banner_type"
					type="radio"
					label="MOD_FLOATING_ADVERTISING_FIELD_BANNER_TYPE_LABEL"
					description="MOD_FLOATING_ADVERTISING_FIELD_BANNER_TYPE_DESC"
					class="btn-group btn-group-yesno"
					default="0"
					filter="integer"
				>
					<option value="1">JYES</option>
					<option value="0">JNO</option>
				</field>

				<field
					name="banner_script"
					type="textarea"
					label="MOD_FLOATING_ADVERTISING_FIELD_SCRIPT_LABEL"
					description="MOD_FLOATING_ADVERTISING_FIELD_SCRIPT_DESC"
					rows="4"
					filter="raw"
					showon="banner_type:1"
				/>

				<field
					name="banner_image"
					type="media"
					label="MOD_FLOATING_ADVERTISING_FIELD_IMAGE_LABEL"
					directory="banners"
					showon="banner_type:0"
				/>

				<field
					name="banner_link"
					type="url"
					label="MOD_FLOATING_ADVERTISING_FIELD_LINK_LABEL"
					filter="url"
					showon="banner_type:0"
				/>

				<field
					name="device_type"
					type="checkboxes"
					label="MOD_FLOATING_ADVERTISING_FIELD_DEVICE_LABEL"
					description="MOD_FLOATING_ADVERTISING_FIELD_DEVICE_DESC"
					multiple="true"
				>
					<option value="phone">MOD_FLOATING_ADVERTISING_DEVICE_PHONE</option>
					<option value="tablet">MOD_FLOATING_ADVERTISING_DEVICE_TABLET</option>
					<option value="desktop">MOD_FLOATING_ADVERTISING_DEVICE_DESKTOP</option>
				</field>
			</fieldset>

			<fieldset name="options" label="COM_MODULES_BASIC_FIELDSET_LABEL">
				<field
					name="prepare_content"
					type="radio"
					label="MOD_FLOATING_ADVERTISING_FIELD_PREPARE_CONTENT_LABEL"
					description="MOD_FLOATING_ADVERTISING_FIELD_PREPARE_CONTENT_DESC"
					class="btn-group btn-group-yesno"
					default="0"
					filter="integer"
				>
					<option value="1">JYES</option>
					<option value="0">JNO</option>
				</field>

				<field
					name="backgroundimage"
					type="media"
					label="MOD_FLOATING_ADVERTISING_FIELD_BACKGROUND_IMAGE_LABEL"
					description="MOD_FLOATING_ADVERTISING_FIELD_BACKGROUND_IMAGE_DESC"
				/>
			</fieldset>

			<fieldset name="advanced">
				<field
					name="layout"
					type="modulelayout"
					label="JFIELD_ALT_LAYOUT_LABEL"
					description="JFIELD_ALT_MODULE_LAYOUT_DESC"
				/>

				<field
					name="moduleclass_sfx"
					type="textarea"
					label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
					description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC"
					rows="3"
				/>

				<field
					name="cache"
					type="list"
					label="COM_MODULES_FIELD_CACHING_LABEL"
					description="COM_MODULES_FIELD_CACHING_DESC"
					default="1"
					filter="integer"
				>
					<option value="1">JGLOBAL_USE_GLOBAL</option>
					<option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
				</field>

				<field
					name="cache_time"
					type="number"
					label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
					description="COM_MODULES_FIELD_CACHE_TIME_DESC"
					default="900"
					filter="integer"
				/>

				<field
					name="cachemode"
					type="hidden"
					default="static"
				/>
			</fieldset>
		</fields>
	</config>

	<updateservers>
		<server type="extension" priority="1" name="Floating Advertising Updates">https://www.asiasun.ir/updates/mod_floating_advertising.xml</server>
	</updateservers>
</extension>
